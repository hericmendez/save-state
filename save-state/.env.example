# Save State environment template — placeholders only, never real secrets.
# Copy to .env for local development and fill in local values.

# Server-only. Local MongoDB for development.
MONGODB_URI=mongodb://localhost:27017/save-state

# Server-only. Must be at least 32 characters. Generate a fresh value per environment.
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars

# Server-only. Session/token lifetime (seconds suffix format: 30m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Canonical application URL (used for links such as password reset).
APP_URL=http://localhost:3000

# Server-only. Reserved for Phase 9 ATP BFF integration. Not used in Phase 1.
ATP_BASE_URL=http://localhost:3000
