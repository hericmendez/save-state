# Save State environment template — placeholders only, never real secrets.
# Copy to .env for local development and fill in local values.

# Local development port. Next.js reads PORT natively (next dev / next start);
# a real PORT in the environment overrides this file. ATP Engine keeps :3000.
PORT=1337

# Server-only. Local MongoDB for development.
MONGODB_URI=mongodb://localhost:27017/save-state

# Server-only. Must be at least 32 characters. Generate a fresh value per environment.
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars

# Server-only. Session/token lifetime (seconds suffix format: 30m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Canonical application URL (used for links such as password reset).
APP_URL=http://localhost:1337

# Server-only. ATP Engine base URL for the Save State BFF (server-to-server).
# ATP keeps its own port (:3000); the browser never calls it directly.
# Required only when SEARCH_METHOD=ATP.
ATP_BASE_URL=http://localhost:3000

# Server-only. Search provider selection. Accepted values: IGDB, ATP.
# IGDB is the default. The browser never reads this value.
SEARCH_METHOD=IGDB

# Server-only. Twitch OAuth credentials for IGDB (Twitch Client ID doubles
# as the IGDB Client-ID header — there is no separate IGDB_CLIENT_ID).
# Required only when SEARCH_METHOD=IGDB.
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
